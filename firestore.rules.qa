rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // QA BYPASS — same as firestore.rules but isUmAddress relaxed to any
    // verified email so any Gmail can QA on qa/bypass (debug). DO NOT deploy
    // this to prod; deploy firestore.rules before release. See lib/auth/auth_service.dart kDebugMode.

    function signedIn() {
      return request.auth != null;
    }

    function isAdminEmail(email) {
      return email == 'l.murillo.546842@umindanao.edu.ph';
    }

    function isUmAddress(email) {
      return email is string
        && email.matches('^[a-z]\\.[a-z]+\\.\\d{6}@umindanao\\.edu\\.ph$');
    }

    // QA: any verified email is a member (bypass isUmAddress)
    function isQaMember(uid) {
      return exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.banned != true;
    }

    function isVerifiedMember(uid) {
      return exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.banned != true;
    }

    function isAdmin(uid) {
      return exists(/databases/$(database)/documents/members/$(uid))
        && get(/databases/$(database)/documents/members/$(uid)).data.isAdmin == true;
    }

    function isBlockedPair(uidA, uidB) {
      return exists(/databases/$(database)/documents/members/$(uidA))
        && exists(/databases/$(database)/documents/members/$(uidB))
        && (get(/databases/$(database)/documents/members/$(uidA)).data.blocked[uidB] == true
            || get(/databases/$(database)/documents/members/$(uidB)).data.blocked[uidA] == true);
    }

    function isCompletedDeal(raterUid, rateeUid, listingId, chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.listingId == listingId
        && get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'sold'
        && ((get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == raterUid
             && get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == rateeUid)
            || (get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId == rateeUid
                && get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId == raterUid));
    }

    match /members/{uid} {
      // QA: isUmAddress check removed — any verified Google email can create its member doc
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/members/$(uid))
        && request.auth.token.email_verified == true
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.isAdmin == isAdminEmail(request.resource.data.email)
        && request.resource.data.banned == false
        && request.resource.data.blocked is map
        && request.resource.data.blocked.size() == 0;

      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
            || isAdminEmail(request.auth.token.email));

      allow update: if signedIn()
        && ((request.auth.uid == uid
             && request.resource.data.uid == uid
             && request.resource.data.email == resource.data.email
             && request.resource.data.isAdmin == resource.data.isAdmin
             && request.resource.data.banned == resource.data.banned)
            || (isAdminEmail(request.auth.token.email)
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['banned'])
                && request.resource.data.banned is bool));

      allow delete: if false;

      match /devices/{token} {
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.token == token
          && request.resource.data.ownerId == uid;
        allow read, update, delete: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.token == token
          && request.resource.data.ownerId == uid;
      }
    }

    match /listings/{listingId} {
      allow create: if isQaMember(request.auth.uid)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.sellerDisplayName is string
        && request.resource.data.sellerDisplayName
             == get(/databases/$(database)/documents/members/$(request.auth.uid))
                  .data.displayName;

      allow read: if signedIn()
        && (resource.data.status == 'active'
            || resource.data.sellerId == request.auth.uid);

      allow update: if isQaMember(request.auth.uid)
        && request.resource.data.sellerId == resource.data.sellerId
        && ((resource.data.sellerId == request.auth.uid
             && request.resource.data.status in ['active', 'sold', 'hidden'])
            || (isAdmin(request.auth.uid)
                && request.resource.data.status == 'hidden'));

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow create: if isQaMember(request.auth.uid)
        && isQaMember(request.resource.data.sellerId)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.participants is map
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[request.auth.uid] == true
        && request.resource.data.participants[request.resource.data.sellerId] == true
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'active'
        && !isBlockedPair(request.auth.uid, request.resource.data.sellerId)
        && request.resource.data.buyerName
             == get(/databases/$(database)/documents/members/$(request.auth.uid))
                  .data.displayName
        && request.resource.data.sellerName
             == get(/databases/$(database)/documents/members/$(request.resource.data.sellerId))
                  .data.displayName;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.buyerId
            || request.auth.uid == resource.data.sellerId
            || request.auth.uid in resource.data.participants);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{msgId} {
        allow create: if isQaMember(request.auth.uid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.type in ['text', 'offer']
          && (request.resource.data.type != 'offer'
              || (request.resource.data.price is number
                  && request.resource.data.price > 0))
          && request.resource.data.participants is map
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[request.auth.uid] == true
          && get(/databases/$(database)/documents/chats/$(chatId)).data.participants
               == request.resource.data.participants
          && get(/databases/$(database)/documents/listings/$(get(/databases/$(database)/documents/chats/$(chatId)).data.listingId)).data.status == 'active'
          && !isBlockedPair(
              request.auth.uid,
              get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId
                  == request.auth.uid
              ? get(/databases/$(database)/documents/chats/$(chatId)).data.sellerId
              : get(/databases/$(database)/documents/chats/$(chatId)).data.buyerId);

        allow read: if signedIn()
          && request.auth.uid in resource.data.participants;

        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if isQaMember(request.auth.uid)
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && (request.resource.data.reportedUid != null
            || request.resource.data.listingId != null
            || request.resource.data.chatId != null);

      allow read, update, delete: if signedIn()
        && isAdminEmail(request.auth.token.email);
    }

    match /ratings/{ratingId} {
      allow create: if isQaMember(request.auth.uid)
        && request.resource.id == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.rateeId != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && isCompletedDeal(
            request.resource.data.raterId,
            request.resource.data.rateeId,
            request.resource.data.listingId,
            request.resource.data.chatId);

      allow read: if signedIn();

      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if isQaMember(request.auth.uid)
        && request.resource.data.ownerId == request.auth.uid;

      allow read: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
